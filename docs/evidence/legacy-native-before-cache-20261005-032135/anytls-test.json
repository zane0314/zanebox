{
  "route": {
    "find_process": true,
    "final": "node-10",
    "rules": [],
    "auto_detect_interface": true,
    "default_domain_resolver": "dns-direct"
  },
  "log": {"level": "warn"},
  "outbounds": [
    {
      "server": "example.org",
      "password": "password",
      "server_port": 443,
      "tls": {
        "utls": {
          "fingerprint": "chrome",
          "enabled": true
        },
        "server_name": "sni.example",
        "alpn": [
          "h2",
          "http/1.1"
        ],
        "insecure": true,
        "reality": {
          "public_key": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
          "short_id": "0123456789abcdef",
          "enabled": true
        },
        "enabled": true
      },
      "tag": "node-10",
      "type": "anytls"
    },
    {
      "tag": "direct",
      "type": "direct"
    },
    {
      "default": "node-10",
      "outbounds": ["node-10"],
      "tag": "proxy",
      "type": "selector"
    }
  ],
  "dns": {
    "servers": [
      {
        "tag": "dns-direct",
        "type": "local"
      },
      {
        "server": "1.1.1.1",
        "path": "/dns-query",
        "detour": "node-10",
        "tag": "dns-remote",
        "type": "https"
      }
    ],
    "final": "dns-remote",
    "rules": [{
      "action": "predefined",
      "rcode": "NOERROR",
      "query_type": ["AAAA"]
    }],
    "strategy": "ipv4_only"
  },
  "inbounds": []
}