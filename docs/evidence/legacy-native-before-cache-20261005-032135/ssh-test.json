{
  "route": {
    "find_process": true,
    "final": "node-13",
    "rules": [],
    "auto_detect_interface": true,
    "default_domain_resolver": "dns-direct"
  },
  "log": {"level": "info"},
  "outbounds": [
    {
      "server": "example.org",
      "password": "fixture-password",
      "server_port": 443,
      "tag": "node-13",
      "type": "ssh",
      "user": "user"
    },
    {
      "tag": "direct",
      "type": "direct"
    },
    {
      "default": "node-13",
      "outbounds": ["node-13"],
      "tag": "proxy",
      "type": "selector"
    }
  ],
  "dns": {
    "servers": [
      {
        "tag": "dns-direct",
        "type": "local"
      },
      {
        "server": "1.1.1.1",
        "path": "/dns-query",
        "detour": "node-13",
        "tag": "dns-remote",
        "type": "https"
      }
    ],
    "final": "dns-remote",
    "rules": [{
      "action": "predefined",
      "rcode": "NOERROR",
      "query_type": ["AAAA"]
    }],
    "strategy": "ipv4_only"
  },
  "inbounds": []
}